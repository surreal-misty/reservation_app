<h1>アカウント情報を編集</h1>

<%= form_with model: resource, url: registration_path(resource_name) do |form| %>
  <div>
    <%= form.label :email, "メールアドレス" %>
    <%= form.email_field :email, autocomplete: "email" %>
  </div>

  <div>
    <%= form.label :password, "新しいパスワード" %>
    <%= form.password_field :password, autocomplete: "new-password" %>
    <p>変更しない場合は空欄にしてください</p>
  </div>

  <div>
    <%= form.label :password_confirmation, "確認用パスワード" %>
    <%= form.password_field :password_confirmation, autocomplete: "new-password" %>
  </div>

  <div>
    <%= form.label :current_password, "現在のパスワード" %>
    <%= form.password_field :current_password, autocomplete: "current-password" %>
  </div>

  <div>
    <%= form.submit "保存" %>
  </div>
<% end %>

<%= link_to "アカウントに戻る", users_account_path %>