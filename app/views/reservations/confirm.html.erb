<div class="reservation-confirm-page">
  <h1>予約内容の確認</h1>

  <div class="reservation-confirm-box">
    <p>
      <span>施設名</span>
      <%= @room.name %>
    </p>

    <p>
      <span>チェックイン</span>
      <%= @reservation.start_date.strftime("%Y/%m/%d") %>
    </p>

    <p>
      <span>チェックアウト</span>
      <%= @reservation.end_date.strftime("%Y/%m/%d") %>
    </p>

    <p>
      <span>宿泊日数</span>
      <%= (@reservation.end_date - @reservation.start_date).to_i %>泊
    </p>

    <p>
      <span>人数</span>
      <%= @reservation.person_num %>人
    </p>

    <p>
      <span>支払い金額</span>
      ¥<%= number_with_delimiter(@reservation.total_amount) %>
    </p>
  </div>

  <%= form_with model: @reservation, url: reservations_path, method: :post, local: true, data: { turbo: false } do |form| %>
    <%= form.hidden_field :room_id %>
    <%= form.hidden_field :start_date %>
    <%= form.hidden_field :end_date %>
    <%= form.hidden_field :person_num %>

    <%= form.submit "この内容で予約する" %>
  <% end %>

  <%= link_to "戻る", room_path(@room), class: "simple-link" %>
</div>