<div class="reservations-page">
  <h1>予約済み一覧</h1>

  <% @reservations.each do |reservation| %>
    <div class="reservation">
      <div class="reservation__image">
        <% if reservation.room.image.attached? %>
          <%= image_tag reservation.room.image %>
        <% else %>
        <%= image_tag "https://rails-02-sample.herokuapp.com/assets/room/default-image-4e0ac6b8d01335b5b22fe6586af13644ae51dddb6aeabf35b9174e80f13cd09d.png" %>
        <% end %>
      </div>

      <div class="reservation__body">
        <h2>
          <%= link_to reservation.room.name, room_path(reservation.room) %>
        </h2>

        <p>紹介文：<%= reservation.room.description %></p>

        <p>
          合計料金：
          ¥<%= number_with_delimiter(reservation.total_amount) %>
        </p>

        <p>チェックイン：<%= reservation.start_date.strftime("%Y/%m/%d") %></p>
        <p>チェックアウト：<%= reservation.end_date.strftime("%Y/%m/%d") %></p>
        <p>予約日時：<%= reservation.created_at.strftime("%Y/%m/%d %H:%M") %></p>
      </div>
    </div>
  <% end %>
</div>