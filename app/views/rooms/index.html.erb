<div class="rooms-page">
  <div class="rooms-header">
    <div>
      <p class="rooms-label">STAY / SEARCH</p>
      <h1>施設を探す</h1>
    </div>

    <%= link_to "＋ 施設を登録", new_room_path, class: "rooms-button" %>
  </div>

  <%= form_with url: rooms_path, method: :get, local: true do |form| %>
  <div>
    <%= form.label :keyword, "キーワード" %>
    <%= form.text_field :keyword, value: params[:keyword] %>
  </div>

  <div>
   <%= form.label :address, "エリア" %>
  <%= form.select :address,
      [["指定なし", ""], ["東京", "東京"], ["大阪", "大阪"], ["京都", "京都"], ["札幌", "札幌"]],
      selected: params[:address] %>
      </div>

  <%= form.submit "検索" %>
<% end %>

 <p>検索結果：<%= @rooms.count %>件</p>

  <div class="rooms-list">
    <% @rooms.each do |room| %>
      <article class="room-card">
        <% if room.image.attached? %>
          <%= image_tag room.image, class: "room-card__image" %>
        <% else %>
          <%= image_tag "https://rails-02-sample.herokuapp.com/assets/room/default-image-4e0ac6b8d01335b5b22fe6586af13644ae51dddb6aeabf35b9174e80f13cd09d.png", class: "room-card__image" %>
        <% end %>

        <div class="room-card__body">
          <p class="room-card__date">
            <%= room.created_at.strftime("%Y/%m/%d") %>
          </p>

          <h2>
            <%= link_to room.name, room_path(room) %>
          </h2>

          <p class="room-card__description">
            <%= room.description %>
          </p>

          <p class="room-card__price">
            ¥<%= number_with_delimiter(room.price) %>
            <span>/泊</span>
          </p>
        </div>
      </article>
    <% end %>
  </div>
</div>