<h1>施設を登録</h1>

<%= form_with model: @room do |form| %>
  <div>
    <%= form.label :name, "施設名" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :description, "紹介文" %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.label :price, "宿泊料金" %>
    <%= form.number_field :price %>
  </div>

  <div>
    <%= form.label :address, "住所" %>
    <%= form.text_field :address %>
  </div>

  <div>
    <%= form.label :image, "施設画像" %>
    <%= form.file_field :image %>
  </div>

  <div>
    <%= form.submit "登録する" %>
  </div>
<% end %>

<%= link_to "戻る", rooms_path %>