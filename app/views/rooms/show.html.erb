<div class="room-detail-page">
  <div class="room-detail-box">
    <h1><%= @room.name %></h1>

    <% if @room.image.attached? %>
      <%= image_tag @room.image, width: 300, class: "room-detail-image" %>
    <% else %>
      <%= image_tag "https://rails-02-sample.herokuapp.com/assets/room/default-image-4e0ac6b8d01335b5b22fe6586af13644ae51dddb6aeabf35b9174e80f13cd09d.png", width: 300, class: "room-detail-image" %>
    <% end %>

    <p>
      <span>紹介文</span>
      <%= @room.description %>
    </p>

    <p>
      <span>宿泊料金</span>
      ¥<%= number_with_delimiter(@room.price) %> /泊
    </p>

    <p>
      <span>住所</span>
      <%= @room.address %>
    </p>
  </div>

  <div class="room-booking-box">
    <h2>予約する</h2>

    <% if user_signed_in? %>
      <%= form_with url: confirm_reservations_path, method: :post, scope: :reservation, local: true, data: { turbo: false } do |form| %>
        <%= form.hidden_field :room_id, value: @room.id %>

        <div>
          <%= form.label :start_date, "チェックイン" %>
          <%= form.date_field :start_date %>
        </div>

        <div>
          <%= form.label :end_date, "チェックアウト" %>
          <%= form.date_field :end_date %>
        </div>

        <div>
          <%= form.label :person_num, "人数" %>
          <%= form.number_field :person_num, min: 1 %>
        </div>

        <%= form.submit "予約内容を確認する" %>
      <% end %>
    <% else %>
      <%= link_to "ログインして予約する", new_user_session_path, class: "rooms-button" %>
    <% end %>
  </div>

  <%= link_to "施設一覧に戻る", rooms_path, class: "simple-link" %>
</div>