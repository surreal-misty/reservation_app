<div class="account-page">
  <h1>プロフィール編集</h1>

  <div class="account-box">
    <%= form_with model: current_user, url: users_profile_path, method: :patch do |form| %>
      <div>
        <%= form.label :image, "アイコン" %>
        <%= form.file_field :image %>
      </div>

      <div>
        <%= form.label :name, "名前" %>
        <%= form.text_field :name %>
      </div>

      <div>
        <%= form.label :introduction, "自己紹介" %>
        <%= form.text_area :introduction %>
      </div>

      <div>
        <%= form.submit "保存" %>
      </div>
    <% end %>
  </div>

  <%= link_to "プロフィールに戻る", users_profile_path, class: "simple-link" %>
</div>